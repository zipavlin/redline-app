{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redline.dev/contracts/v3/bootstrap.schema.json",
  "title": "Redline BootstrapResponse",
  "description": "Wire shape of GET /{api}/bootstrap - the public capability manifest the widget and dashboard fetch at mount. Fail-closed on any shape violation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "features", "capabilities", "csrf"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Contract version. Currently 3. Bumped only on breaking contract changes (v2 removed the report has_media filter in favor of screenshot:exists / video:exists; v3 changed authentication-denied responses from HTTP 401 to HTTP 403 with an added error:\"unauthenticated\" marker and made GET /auth/me answer 200 {\"user\": null} when no credentials are presented).",
      "const": 3
    },
    "features": {
      "type": "array",
      "description": "Enabled feature flags - opt-in: a feature is enabled if and only if its name is listed in REDLINE_FEATURES (comma-separated; an empty default enables none). Missing from the list = disabled.",
      "items": {
        "type": "string",
        "enum": ["screenshots", "videos", "files", "comments", "mcp"]
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guest_reporting", "auth", "mail"],
      "properties": {
        "guest_reporting": {
          "type": "boolean",
          "description": "redline.auth.guest - anonymous report submission allowed."
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "can_login",
            "can_register",
            "fields",
            "can_select_role",
            "requires_approval",
            "requires_email_verification",
            "login_mode"
          ],
          "properties": {
            "can_login": { "type": "boolean" },
            "can_register": { "type": "boolean" },
            "fields": {
              "type": "array",
              "description": "Provider-specific extra registration fields.",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["name", "type"],
                "properties": {
                  "name": { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": ["string", "number", "password", "pin"]
                  },
                  "label": { "type": "string" },
                  "placeholder": { "type": "string" }
                }
              }
            },
            "can_select_role": { "type": "boolean" },
            "requires_approval": { "type": "boolean" },
            "requires_email_verification": { "type": "boolean" },
            "login_mode": {
              "type": "string",
              "enum": ["credentials", "session"],
              "description": "How the frontend obtains a redline session: credentials = email/password login form; session = exchange the host application session via an empty-body POST auth/login."
            }
          }
        },
        "mail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configured"],
          "properties": {
            "configured": { "type": "boolean" }
          }
        }
      }
    },
    "csrf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cookie", "header"],
      "properties": {
        "cookie": { "type": "string" },
        "header": { "type": "string" }
      }
    }
  }
}
