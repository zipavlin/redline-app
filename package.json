{
  "name": "redline-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:build-widget": "cross-env NODE_ENV=development REDLINE_TARGET=widget vite build --mode development",
    "dev:build-dashboard": "cross-env NODE_ENV=development REDLINE_TARGET=dashboard vite build --mode development",
    "build": "npm run build:widget && npm run build:dashboard",
    "build:widget": "cross-env NODE_ENV=production REDLINE_TARGET=widget vite build --mode production",
    "build:dashboard": "cross-env NODE_ENV=production REDLINE_TARGET=dashboard vite build --mode production",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.30.0",
    "@nuxt/ui": "^4.10.0",
    "@svgdotjs/svg.draggable.js": "^3.0.6",
    "@svgdotjs/svg.js": "^3.2.8",
    "@svgdotjs/svg.resize.js": "^2.0.5",
    "@svgdotjs/svg.select.js": "^4.0.3",
    "@tanstack/vue-query": "^5.101.4",
    "@tiptap/extension-bold": "^3.29.2",
    "@tiptap/extension-document": "^3.29.2",
    "@tiptap/extension-hard-break": "^3.29.2",
    "@tiptap/extension-history": "^3.29.2",
    "@tiptap/extension-italic": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-paragraph": "^3.29.2",
    "@tiptap/extension-strike": "^3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "@zumer/snapdom": "^2.23.2",
    "html-to-image": "^1.11.13",
    "pinia": "^4.0.2",
    "reka-ui": "^2.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.1.1",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
